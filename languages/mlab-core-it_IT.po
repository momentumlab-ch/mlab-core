#. Plugin Name of the plugin
#: mlab-core.php
msgid "MomentumLab Core"
msgstr "MomentumLab Core"

#. Description of the plugin
#: mlab-core.php
msgid "Shows the MomentumLab plugins with your license key, installs and activates them with one click, and keeps them up to date. Manages the GitHub read tokens for updates from private repositories."
msgstr "Mostra i plugin MomentumLab con la chiave di licenza, li installa e attiva con un clic e li mantiene aggiornati. Gestisce i token di lettura GitHub per gli aggiornamenti dai repository privati."

