{
	"name": "momentumlab-ch/mlab-core",
	"description": "Installs, activates and updates MomentumLab plugins with a license key.",
	"license": "GPL-2.0-or-later",
	"type": "wordpress-plugin",
	"require": {
		"php": ">=8.0"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"wp-coding-standards/wpcs": "^3.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "8.0.30"
		}
	},
	"scripts": {
		"test": "phpunit",
		"lint": "phpcs"
	}
}
